#!/bin/bash
# Runs the model server detached from the QwenFlash manager, so restarting or upgrading the manager doesn't restart
# the model. The server gets its own session; its output goes to .qwenflash/backend.log with elapsed-time stamps.
#
#   bin/qwenflash-backend start [KEY=VALUE ...] -- [run.sh args]   prints "started PID"
#   bin/qwenflash-backend stop [timeout_s]                         stops ours and any stray qwen_server.py
#   bin/qwenflash-backend status                                   "running PID", "stray PIDS" or "stopped"
#   bin/qwenflash-backend dropcache 1|3                            hand page cache back (WSL; needs root)
set -u
cd "$(dirname "$(readlink -f "$0")")/.."
D=.qwenflash
mkdir -p "$D"
PIDF=$D/backend.pid
LOG=$D/backend.log
alive() { [ -f "$PIDF" ] && kill -0 "$(cat "$PIDF")" 2>/dev/null; }
strays() { pgrep -f '[q]wen_server\.py' | tr '\n' ' '; }

case "${1:-}" in
  start)
    shift
    envs=()
    while [ $# -gt 0 ] && [ "$1" != "--" ]; do envs+=("$1"); shift; done
    [ "${1:-}" = "--" ] && shift
    if alive; then echo "running $(cat "$PIDF")"; exit 3; fi
    if [ -n "$(strays)" ]; then echo "stray $(strays)"; exit 4; fi      # another server would hold the port and GPU
    echo "# $(date '+%F %T') start: ${envs[*]} ./run.sh $*" > "$LOG"
    setsid bash -c '"$@" 2>&1 | python3 -u bin/qwenflash-timestamp' \
      qwenflash env "${envs[@]}" ./run.sh "$@" >> "$LOG" 2>&1 < /dev/null &
    echo $! > "$PIDF"
    echo "started $!"
    ;;
  stop)
    t=${2:-30}
    if alive; then
      p=$(cat "$PIDF")
      pkill -TERM -g "$p" -f '[q]wen_server\.py' 2>/dev/null
      for _ in $(seq $((t * 2))); do kill -0 "$p" 2>/dev/null || break; sleep 0.5; done
      kill -KILL -- "-$p" 2>/dev/null
    fi
    if [ -n "$(strays)" ]; then
      pkill -TERM -f '[q]wen_server\.py'
      for _ in $(seq $((t * 2))); do [ -n "$(strays)" ] || break; sleep 0.5; done
      pkill -KILL -f '[q]wen_server\.py'
    fi
    rm -f "$PIDF"
    echo stopped
    ;;
  status)
    if alive; then echo "running $(cat "$PIDF")"
    elif [ -n "$(strays)" ]; then echo "stray $(strays)"
    else echo stopped; fi
    ;;
  dropcache)
    sync
    if [ -w /proc/sys/vm/drop_caches ]; then echo "${2:-1}" > /proc/sys/vm/drop_caches; echo dropped
    else echo "skipped (not root)"; fi
    ;;
  *) echo "usage: $0 {start [K=V ...] -- [run.sh args] | stop [timeout] | status | dropcache 1|3}"; exit 2 ;;
esac
