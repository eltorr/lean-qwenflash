#!/usr/bin/env python3
"""Prefix each line of the model server's output with the seconds since it started (for .qwenflash/backend.log).

A shell `while read` loop would do, but under WSL it is killed when the wsl.exe that started the server exits,
taking the server down with it (it dies writing to the closed pipe); a Python filter survives."""
import sys
import time

t0 = time.time()
for raw in sys.stdin.buffer:
    sys.stdout.write("[%6ds] %s" % (time.time() - t0, raw.decode("utf-8", "replace")))
    sys.stdout.flush()
